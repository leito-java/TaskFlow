{
  "name": "taskflow-frontend",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --no-watch --no-progress",
    "test:watch": "ng test",
    "test:coverage": "ng test --no-watch --coverage",
    "test:e2e:install": "node scripts/install-playwright.mjs",
